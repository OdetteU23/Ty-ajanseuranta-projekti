<Window x:Class="WpfApp3.StartWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        xmlns:viewModel="clr-namespace:WpfApp3.MVVM.ViewModel"
		 mc:Ignorable="d"
         Title="Chrono"
         Icon="/Images/app-icon-white-128.png"
		 Height="650" Width="980"
		 ResizeMode="CanMinimize"
		 Background="Transparent"
        MouseDown="Window_MouseDown"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">


    <Window.DataContext>
        <viewModel:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="13*"/>
            <ColumnDefinition Width="36*"/>
        </Grid.ColumnDefinitions>

        <Border Background="#212121"
            CornerRadius="0,0,10,10" Grid.ColumnSpan="2">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition/>

                </Grid.RowDefinitions>
                        
                        <Label  Grid.Row="0" Grid.Column="0"
                                    Content="Chrono"
                                    Foreground="LightGray"
                                    FontWeight="SemiBold"/>
                
                        <Grid Grid.Row="0" Grid.Column="1">
                            

                            <StackPanel Grid.Column="1"
                                        HorizontalAlignment="Stretch"
                                        Margin="300,0,0,0">

                                <Button Height="20" Width="20"
                                        Background="#D54134"
                                        Foreground="Black"
                                        BorderThickness="0"
                                        Content="X"
                                        Click="ButtonClose_Click"
                                        HorizontalAlignment="Right"/>

                            </StackPanel>

                        </Grid>


                        <TextBlock Text="Chrono"
                           Grid.Row="1" Grid.Column="1"
						   VerticalAlignment="Center"
						   HorizontalAlignment="Left"
						   Foreground="White"
						   FontSize="30"/>

                <StackPanel Grid.Row="1" Grid.Column="0"
                            Margin="10">
                    <Image Source="/Images/app-icon-white-258.png"
                           Margin="10"
                           Width="60" Height="60"
                           />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <RadioButton Content="Home"
								 Height="70"
								 Margin="0,10,0,10"
								 Foreground="White"
								 FontSize="16"
								 Style="{StaticResource MenuButtonTheme}"
                                 IsChecked="True"
                                 Command="{Binding HomeViewCommand}"/>

                    <RadioButton Content="Calendar"
								 Height="70"
								 Margin="0,10,0,10"
								 Foreground="White"
								 FontSize="16"
                                 Style="{StaticResource MenuButtonTheme}"
                                 Command="{Binding CalendarViewCommand}"/>


                    <RadioButton Content="Notes"
								 Height="70"
								 Margin="0,10,0,10"
								 Foreground="White"
								 FontSize="16"
								 Style="{StaticResource MenuButtonTheme}"
                                 Command="{Binding NotesViewCommand}"/>

                    <RadioButton Content="Thanks"
								 Height="70"
								 Margin="0,10,0,10"
								 Foreground="White"
								 FontSize="16"
                                 Style="{StaticResource MenuButtonTheme}"
                                 Command="{Binding ThnxViewCommand}"/>

                </StackPanel>

                <ContentControl Grid.Row="2"
								Grid.Column="1"
								Margin="10"
								Content="{Binding CurrentView}"
                                />

            </Grid>
        </Border>
    </Grid>






</Window>