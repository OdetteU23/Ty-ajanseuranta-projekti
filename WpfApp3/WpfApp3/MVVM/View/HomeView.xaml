<UserControl x:Class="WpfApp3.MVVM.View.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfApp3.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border CornerRadius="20"
            BorderThickness="4"
            BorderBrush="white">
        <StackPanel Orientation="Horizontal">
        <TextBlock Text="Get started"
                   Height="50"
                   Foreground="White"
                   FontSize="28"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Margin="30,20,10,20"/>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Border CornerRadius="20"
                    BorderThickness="4"
                    BorderBrush="#F2F2F2"
                Width="200"
                Height="300"
                Margin="30">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="2,1">
                            <GradientStop Color="#0E8BF1" Offset="0.0"/>
                        <GradientStop Color= "#8FD2DB" Offset="1"/>
                    </LinearGradientBrush>

                </Border.Background>

                <Border.Clip>
                    <RectangleGeometry RadiusX="10"
                                   RadiusY="10"
                                   Rect="0,0,200,300"/>

                </Border.Clip>

                <Grid>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Calendar"
                               Foreground="White"
                               FontSize="28"
                               Margin="20,20,20,0"/>
                        <TextBlock Text="Scheduele and track &#x0a;your work time"
                               Foreground="White"
                               FontSize="16"
                               Margin="20,50,10,0"
                               VerticalAlignment="Bottom"/>

                    </StackPanel>
                    <Grid HorizontalAlignment="Left" Margin="100,200,0,0" VerticalAlignment="Top">

                        <Image Width="70"
                            Height="70"
                            Source="/Images/calendar-clock-white.png"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                       />
                    </Grid>
                </Grid>

            </Border>
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center">
            <Border CornerRadius="20"
                    BorderThickness="4"
                    BorderBrush="#F2F2F2" 
                    Width="200"
                Height="300"
                Margin="30">

                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="2,1">
                            <GradientStop Color="#0E8BF1" Offset="0.0"/>
                            <GradientStop Color= "#8FD2DB" Offset="1"/>
                    </LinearGradientBrush>

                </Border.Background>

                <Border.Clip>
                    <RectangleGeometry RadiusX="10"
                                   RadiusY="10"
                                   Rect="0,0,200,300"/>

                </Border.Clip>

                <Grid>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Notes"
                               Foreground="White"
                               FontSize="28"
                               Margin="20,20,20,0"/>
                        <TextBlock Text="Leave notes and &#x0a;communicate"
                               Foreground="White"
                               FontSize="16"
                               Margin="20,50,10,0"
                               VerticalAlignment="Bottom"/>

                    </StackPanel>
                    <Grid HorizontalAlignment="Left" Margin="100,200,0,0" VerticalAlignment="Top">

                        <Image Width="70"
                            Height="70"
                            Source="/Images/comment-bubble-white.png"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                       />
                    </Grid>
                </Grid>

            </Border>
        </StackPanel>

    </StackPanel>
    </Border>
</UserControl>
