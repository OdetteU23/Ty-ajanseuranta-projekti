<Window x:Class="WpfApp3.MVVM.View.Compare"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3.MVVM.View"
        mc:Ignorable="d"
        Title="Compare" 
        Icon="/Images/app-icon-white-128.png"
        Background="Transparent"
        Height="500" Width="600"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        >

    <!--outer grid and rounded border-->
    <Grid x:Name="Grid">

        <Border Background="#212121"
                CornerRadius="0,0,10,10">


            <Canvas x:Name="Canvas" 
                Background="Transparent" 
                TextInput="Text_Input">

                <!--outer panel and inner grid-->
                <StackPanel>
                    <Grid Height="400">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="41*"/>
                            <RowDefinition Height="135*"/>
                            <RowDefinition Height="24*"/>
                            <RowDefinition Height="0*"/>
                        </Grid.RowDefinitions>

                        <!--panels with content-->


                        <!--panel with textblocks displaying saved hours or shifts-->

                        <StackPanel x:Name="PanelRow0"
                                VerticalAlignment="Center" Height="84"
                                >
                            <Grid Width="600">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.5*"/>
                                    <ColumnDefinition Width="0.5*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.2*"/>
                                    <RowDefinition Height="0.8*"/>
                                </Grid.RowDefinitions>


                                <StackPanel Grid.Row="0"
                                        Grid.Column="0"
                                        Orientation="Vertical">

                                    <TextBlock x:Name="TavoiteBlock" 
                                                   Foreground="White"
                                                   Text="Username" 
                                                   Width="200" Height="24" 
                                                   TextWrapping="Wrap" 
                                                   FontSize="18" />

                                    <Border Margin="5">


                                        <TextBox x:Name="TextBox1"
                                                 TextWrapping="Wrap" 
                                                 Width="200" Height="25"
                                                 FontSize="18"
                                                 TextChanged="TextBox_TextChanged" RenderTransformOrigin="1,0"/>
                                    </Border>

                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                        Grid.Row ="0">

                                    <TextBlock x:Name="toteutusBlock" 
                                                   Foreground="White"
                                                   Text="weekly goal hours" 
                                                   TextWrapping="Wrap"
                                                   FontSize="18" 
                                                   Height="24" Width="200"/>

                                    <Border Margin="5">


                                        <TextBox x:Name="TextBox2"  
                                                TextWrapping="Wrap"  
                                                Width="200" Height="25"
                                                FontSize="18" 
                                                TextChanged="TextBox_TextChanged_1"/>
                                    </Border>
                                </StackPanel>


                            </Grid>
                        </StackPanel>

                        <!--panel with messagebox / displayable info for user-->

                        <StackPanel x:Name="PanelRow1"
                                Grid.Row="1"
                                Margin="38,10,100,10"
                                Orientation="Horizontal">

                            <Image x:Name="ReturnMessageInfoIcon"
                                   Width="40" Height="40"
                                    Source="/Images/time-info-white.png"/>

                            <Border Margin="5">


                                <TextBlock x:Name="TulosBlock"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap" 
                                   Background="WhiteSmoke" 
                                   FontSize="13" 
                                   Width="420" Height="198"/>
                            </Border>
                        </StackPanel>

                        <!--panel with button to check hours-->

                        <StackPanel x:Name="PanelRow2"
                                Grid.Row="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Height="70" Width="150">
                            <Button x:Name="ButtonText" 
                                Content="Check"
                                FontSize="20" 
                                Click="Button_Click" 
                                Height="70" Width="150" 
                                />
                        </StackPanel>

                    </Grid>
                </StackPanel>

            </Canvas>

        </Border>
    </Grid>
</Window>