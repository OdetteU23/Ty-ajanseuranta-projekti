<Window x:Class="WpfApp3.AddNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp3"
        mc:Ignorable="d"
        Height="450" Width="600"
         WindowStyle = "None"
         ResizeMode="NoResize"
         Background="Transparent"
         AllowsTransparency="True"
        
        >


    <Grid>

        <!--making shit round again because styyyyle-->
        <Border Background="#212121"
        CornerRadius="10">

            <!--outer grid-->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="0.06*"/>
                    <RowDefinition Height="0.7*"/>
                    <RowDefinition Height="0.2*"/>

                </Grid.RowDefinitions>

                <!--that upper row with buttons to close this thingy-->
                <Border Grid.ColumnSpan="2"
                        Grid.Row="0"
                        Background="#252525">

                    <Grid HorizontalAlignment="Stretch">
                        <Label Content="Add note"
                                Foreground="LightGray"
                                FontWeight="SemiBold"/>

                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal">

                            <Button Height="20" Width="20"
                                    Background="#D54134"
                                    Foreground="Black"
                                    BorderThickness="0"
                                    Content="X"
                                    Click="ButtonClose_Click"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <StackPanel Grid.Row="1"
                            >

                    <!--more grid to arrange insides of this.. this.-->
                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.25*"/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <!--here you are supposed to pick date for your note-->
                        <StackPanel Grid.Row="0">
                            <DatePicker x:Name="datePicker"
                                        Height="30" Width="550"
                                        Margin="20"
                                        />
                        </StackPanel>

                        <!--panel with text box-->

                        <StackPanel Grid.Row="2">
                            <Border CornerRadius="10,10,10,10" >
                                <Border.Clip>
                                    <RectangleGeometry RadiusX="10"
                                                        RadiusY="10"
                                                        Rect="25,25,550,190"/>
                                </Border.Clip>

                                <TextBox    x:Name="addNoteTextbox"
                                            Height="200" Width="550"
                                            Margin="20"
                                            />
                            </Border>
                        </StackPanel>



                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <Button Height="50" Width="200"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Content="Save note"
                                    Click="ButtonSave_Click"
                                    
                                    Margin="10" Background="#9ABB53"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

        </Border>
    </Grid>
</Window>
