<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Username, Date, and Hours Saver" Height="300" Width="400">
    <Grid Margin="0,0,0,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="35.96"/>
            <RowDefinition Height="Auto" MinHeight="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="18"/>
            <RowDefinition Height="Auto" MinHeight="35.96"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="usernameTextBlock" Text="Enter username" Margin="10,10,10,10"/>
        <TextBox x:Name="usernameTextBox" Margin="10,27,10,0" VerticalAlignment="Top" Height="18" Grid.RowSpan="2"/>

        <TextBlock x:Name="dateTextBlock" Grid.Row="2" Text="Enter date" Margin="10,5,10,15"/>
        <DatePicker x:Name="datePicker" Grid.Row="3" Margin="10,0,10,0" VerticalAlignment="Top" Height="24"/>

        <TextBlock x:Name="startTimeTextBlock" Grid.Row="4" Text="Enter start time (format: HH:mm)" Margin="10,0,10,20"/>
        <TextBox x:Name="startTimeTextBox" Grid.Row="4" Margin="10,26,10,0" VerticalAlignment="Top" Height="18" Grid.RowSpan="2"/>

        <TextBlock x:Name="endTimeTextBlock" Grid.Row="6" Text="Enter end time (format: HH:mm)" Margin="10,0,10,35"/>
        <TextBox x:Name="endTimeTextBox" Grid.Row="6" Margin="10,26,10,0" VerticalAlignment="Top" Height="18"/>

        <Button Content="Save Username, Date, and Hours" Grid.Row="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="119,49,0,0" Click="OnSaveButtonClick" Height="20" Width="177"/>
    </Grid>
</Window>
