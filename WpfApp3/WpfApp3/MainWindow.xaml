<Window x:Class="WpfApp3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Username and Hours Saver" Height="300" Width="400">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock x:Name="usernameTextBlock" Text="Enter username" Margin="10"/>
		<TextBox x:Name="usernameTextBox" Grid.Row="1" Margin="10" VerticalAlignment="Center"/>

		<TextBlock x:Name="startTimeTextBlock" Grid.Row="2" Text="Enter start time (format: 12.09.2023 13:00)" Margin="10"/>
		<TextBox x:Name="startTimeTextBox" Grid.Row="3" Margin="10" VerticalAlignment="Center"/>

		<TextBlock x:Name="endTimeTextBlock" Grid.Row="4" Text="Enter end time ( format: 12.09.2023 22:00)" Margin="10"/>
		<TextBox x:Name="endTimeTextBox" Grid.Row="5" Margin="10" VerticalAlignment="Center"/>

		<Button Content="Save Username and Hours" Grid.Row="6" HorizontalAlignment="right" VerticalAlignment="Center" Margin="10" Click="OnSaveButtonClick"/>
		<ComboBox x:Name="userComboBox" Grid.Row="6" HorizontalAlignment="center" VerticalAlignment="Center" Margin="10" Width="150" SelectedIndex="0"/>
		<Button Content="see user data" Grid.Row="6" HorizontalAlignment="left" VerticalAlignment="Center" Margin="10" Click="SeeUserData"/>
	</Grid>
</Window>

